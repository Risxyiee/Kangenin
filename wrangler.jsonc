{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kangenin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // S-05 monitoring: log console.error semua API terlihat di dashboard
  // Cloudflare (Workers → Logs) berkat observability di atas; error
  // terstruktur juga tersimpan di tabel error_log (Supabase) via
  // src/lib/monitor.ts. Sentry bisa disusulkan nanti kalau traffic naik.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_DB",
      // ATURAN ARSITEKTUR: origin WAJIB direct connection Supabase port 5432
      // (db.nulaitlgupgfonqjqcol.supabase.co), DILARANG pooler Supabase (6543).
      // Hyperdrive sudah bertindak sebagai pooler global — double-pooling
      // menyebabkan koneksi zombie & query menggantung.
      "id": "01a56693e6eb4127a3bf81c99381b82b",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
      // CATATAN 2026-11-02 — caching query Hyperdrive (TTL ±60 dtk) membuat
      // read-after-write basi (insiden: PATCH status admin masukan sukses tapi
      // GET langsung masih "baru" ±60-70 dtk). Matikan lewat DASHBOARD:
      // Storage & Databases → Hyperdrive → config ini → Settings → Caching
      // → Disable. (Field `caching` di binding TIDAK didukung wrangler 4.156.x
      // — hanya warning "Unexpected fields" dan bisa di-reject API saat deploy,
      // jadi sengaja tidak ditulis di sini.)
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
